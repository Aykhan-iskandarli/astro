{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "assets/*": [
        "./src/assets/*"
      ],
      "core/*": [
        "./src/core/*"
      ],
      "pages/*": [
        "./src/pages/*"
      ],
      "router/*": [
        "./src/router/*"
      ],
      "store/*": [
        "./src/store/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
